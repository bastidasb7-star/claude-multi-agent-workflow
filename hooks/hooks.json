{
  "description": "Lint every JavaScript file Claude writes or edits with the project's own ESLint.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-on-edit.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
